{
  "description": "Décode Suricata, conserve les horodatages et normalise les adresses IP",
  "processors": [
    {
      "rename": {
        "field": "@timestamp",
        "target_field": "event.ingested",
        "ignore_missing": true
      }
    },
    {
      "json": {
        "field": "message",
        "target_field": "suricata"
      }
    },
    {
      "date": {
        "field": "suricata.timestamp",
        "target_field": "@timestamp",
        "formats": [
          "ISO8601"
        ],
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "source.ip",
        "copy_from": "suricata.src_ip",
        "ignore_empty_value": true
      }
    },
    {
      "set": {
        "field": "destination.ip",
        "copy_from": "suricata.dest_ip",
        "ignore_empty_value": true
      }
    }
  ]
}
